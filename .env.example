# ========================================================
# AURA AI Classroom Attendance - Email & SMTP Settings
# ========================================================

# If using Gmail:
# 1. Turn on 2-Step Verification in your Google Account:
#    https://myaccount.google.com/security
# 2. Generate an "App Password" (select app: Mail):
#    https://myaccount.google.com/apppasswords
# 3. Paste your 16-character Google App Password below:

AURA_SMTP_HOST=smtp.gmail.com
AURA_SMTP_PORT=587
AURA_SMTP_USER=your_email@gmail.com
AURA_SMTP_PASS=xxxx xxxx xxxx xxxx
AURA_SMTP_FROM=your_email@gmail.com

# (Optional) Whitelist specific college domains separated by commas.
# Leave blank to allow all student emails:
AURA_ALLOWED_EMAIL_DOMAINS=
